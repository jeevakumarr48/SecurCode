SECURCODE_ENV=development
SECURCODE_DEMO_MODE=false
# Generate at least 32 random characters; required in production for one-time first-admin bootstrap.
SECURCODE_BOOTSTRAP_TOKEN=
SECURCODE_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SECURCODE_DEMO_SCAN_COOLDOWN_SECONDS=10
SECURCODE_MAX_SCAN_FILES=5000
SECURCODE_MAX_SCAN_DEPTH=30
SECURCODE_MAX_SCAN_SECONDS=120
SECURCODE_MAX_SOURCE_FILE_BYTES=2000000
SECURCODE_MAX_SCAN_BYTES=100000000
# Private production requires an absolute path whose parent is an existing mounted directory.
# Demo deployments may use an ephemeral default database; its data will not survive host replacement.
# SECURCODE_DATABASE_PATH=C:/path/to/securcode.sqlite
