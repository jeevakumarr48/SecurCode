# SecurCode environment reference. Copy to .env for local use; never commit .env.
# Values below are placeholders.

# --- Common -------------------------------------------------------------------
SECURCODE_ENV=development                 # development | test | production
SECURCODE_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SECURCODE_PUBLIC_APP_URL=http://localhost:5173   # used in emailed links

# --- Database ---------------------------------------------------------------
# Unset: the platform uses the SQLite file at SECURCODE_DATABASE_PATH (local dev).
# Production: PostgreSQL, e.g. postgresql://user:password@host:5432/securcode
SECURCODE_DATABASE_URL=
# SECURCODE_DATABASE_PATH=C:/path/to/sentinelops.db
# SECURCODE_ALLOW_SQLITE_IN_PRODUCTION=false

# --- Secrets (required in production) -----------------------------------------
# Fernet key for encrypting GitHub tokens, webhook secrets and MFA secrets:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECURCODE_ENCRYPTION_KEY=
# Docker compose only:
POSTGRES_PASSWORD=

# --- Sessions and cookies ------------------------------------------------------
SECURCODE_COOKIE_SECURE=false             # true in production (forced)
SECURCODE_COOKIE_SAMESITE=lax             # lax | strict | none (none requires secure)
SECURCODE_SESSION_HOURS=12
SECURCODE_SESSION_IDLE_MINUTES=120
SECURCODE_TRUST_PROXY_HEADERS=false       # true only behind a trusted reverse proxy
SECURCODE_REGISTRATION_OPEN=true
SECURCODE_REQUIRE_EMAIL_VERIFICATION=false
SECURCODE_LOGIN_MAX_FAILURES=8
SECURCODE_LOCKOUT_MINUTES=15

# --- Email (optional; without it, dev prints links to the server console and
#     invitation links are shown once to the inviting administrator) ---------
SECURCODE_SMTP_HOST=
SECURCODE_SMTP_PORT=587
SECURCODE_SMTP_USERNAME=
SECURCODE_SMTP_PASSWORD=
SECURCODE_SMTP_FROM=SecurCode <no-reply@example.com>
SECURCODE_SMTP_STARTTLS=true

# --- Scanning ----------------------------------------------------------------
SECURCODE_MAX_UPLOAD_BYTES=25000000
SECURCODE_MAX_ARCHIVE_MEMBERS=20000
SECURCODE_MAX_EXTRACTED_BYTES=200000000
SECURCODE_SCAN_TIMEOUT_SECONDS=300
SECURCODE_SCAN_MEMORY_MB=1024
SECURCODE_WORKER_CONCURRENCY=2
SECURCODE_EMBEDDED_WORKER=false           # true = run worker process inside the API container
SECURCODE_SCAN_WORKDIR=

# --- GitHub ------------------------------------------------------------------
SECURCODE_GITHUB_API_URL=https://api.github.com

# --- Legacy single-tenant console (SQLite only) -----------------------------------
SECURCODE_LEGACY_API=                      # default: on for SQLite, off for PostgreSQL
SECURCODE_DEMO_MODE=false
SECURCODE_BOOTSTRAP_TOKEN=
SECURCODE_DEMO_SCAN_COOLDOWN_SECONDS=10
SECURCODE_MAX_SCAN_FILES=5000
SECURCODE_MAX_SCAN_DEPTH=30
SECURCODE_MAX_SCAN_SECONDS=120
SECURCODE_MAX_SOURCE_FILE_BYTES=2000000
SECURCODE_MAX_SCAN_BYTES=100000000

# --- Frontend build (Vite) ------------------------------------------------------
# Either an HTTPS API origin, or same-origin proxying (Vercel rewrites / nginx):
VITE_API_BASE_URL=
VITE_SAME_ORIGIN_API=false
