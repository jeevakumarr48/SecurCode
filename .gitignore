# Python runtime and test artifacts
backend/.venv/
backend/**/__pycache__/
backend/.pytest_cache/
*.py[cod]

# Local application data
backend/*.db
.env
.env.*
!.env.example

# Frontend dependencies and build output
frontend/node_modules/
frontend/dist/
```gitignore

# Additional Python test and runtime artifacts
.pytest_cache/
**/.pytest_cache/
__pycache__/
**/__pycache__/
.coverage
htmlcov/

# Logs and temporary files
*.log
*.tmp

# Local databases anywhere in the project
*.db
*.sqlite
*.sqlite3
*.db-*
*.sqlite-*
*.sqlite3-*
*.bak
*.backup
*.dump

# Local secrets, credentials, and key material
.secrets/
secrets/
.credentials/
credentials/
*.secret
*.token
*.credentials
*.pem
*.key
*.p12
*.pfx

# Frontend tooling
frontend/.vite/
frontend/test-results/
frontend/playwright-report/

# Operating system files
.DS_Store
Thumbs.db

# Editor and temporary files
*.temp
*.swp
*.swo
